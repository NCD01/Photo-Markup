#!/usr/bin/env sh
set -eu

# Block pushes that do not include a VERSION bump.
# This enforces version discipline across all pushes.

missing_bump=0

while read -r local_ref local_sha remote_ref remote_sha
do
  # Deletion push; skip.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch: inspect full history reachable from local ref.
    changed="$(git diff-tree --no-commit-id --name-only -r "$local_sha" | grep -E '^VERSION$' || true)"
    if [ -z "$changed" ]; then
      # Fallback: check recent range for VERSION changes.
      changed="$(git log --name-only --pretty=format: -n 50 "$local_sha" | grep -E '^VERSION$' || true)"
    fi
  else
    changed="$(git diff --name-only "$remote_sha..$local_sha" | grep -E '^VERSION$' || true)"
  fi

  if [ -z "$changed" ]; then
    missing_bump=1
  fi
done

if [ "$missing_bump" -ne 0 ]; then
  echo ""
  echo "Push blocked: VERSION bump required."
  echo "Run:"
  echo "  powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1 -Bump minor -Reason \"<reason>\""
  echo "Then commit and push again."
  exit 1
fi

exit 0

